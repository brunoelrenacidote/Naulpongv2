{
  "name": "naulpong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev --port 1999",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run dev:worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "next": "14.2.35",
    "partysocket": "^1.1.18",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.87.0"
  }
}
